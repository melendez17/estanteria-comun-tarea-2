{
  "name": "estanteria-buscador", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "sass": "sass --load-path=node_modules --silence-deprecation=import,global-builtin,color-functions scss/main.scss public/css/main.css --style=compressed --no-source-map",
    "sass:watch": "npm run sass -- --watch",
    "build": "npm run sass && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": { "bootstrap": "5.3.8" },
  "devDependencies": { "sass": "1.93.2", "vite": "6.4.1" }
}
